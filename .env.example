# Copy to .env.local (local dev) and add the same values in Vercel → Project → Settings → Environment Variables.
# Find these in Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server only. Used to create kid logins. Never share or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "false" after your family account is created so no one else can sign up.
ALLOW_SIGNUP=true
